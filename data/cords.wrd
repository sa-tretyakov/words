/* 
  Cords (Нити) — базовые абстрактные интерфейсы (глаголы и свойства) для всех устройств.
  
   Образ диалога с устройством
   Этот файл является образом диалога, который обучает систему универсальным
   "нитям" — концептуальным цепочкам действий. В будущем на эти нити будут
   "нанизываться" конкретные бусины (bead) для различных устройств (например,
   face.on, led.on, motor.left).
   
   Нить — это не действие, а "крючок", который ждёт, когда на него нанижут
   конкретную реализацию. Благодаря этому одно слово (например, "speed") может
   управлять одновременно моторами, сервоприводами и анимациями.
   
   Обучить модуль можно введя этот диалог: load cords.wrd <--
*/

cords cont // Переходим в контекст "cords" для хранения абстрактных интерфейсов

// === 1. Базовое управление состоянием ===
on cord         // Нить включения (ожидает бусины типа face.on, led.on, motor.on)
off cord        // Нить выключения
not cord         // Нить инвертирования состояния (например, для мигания led.not)

// === 2. Аналоговые и градуированные параметры ===
brightness cord  // Яркость (для матриц, лент, подсветки)
speed cord       // Скорость (для моторов, анимаций, таймеров)
level cord       // Уровень (заряд батареи, уровень сигнала, воды)
volume cord      // Громкость (для динамика/buzzer, 0-100%)

// === 3. Цвет и визуализация ===
color cord       // Цвет (для RGB-лент, пикселей, эмоций)

// === 4. Движение и позиционирование ===
direction cord   // Направление (вперед/назад, 1/-1, угол поворота)
position cord    // Позиция (для сервоприводов, шаговых моторов, энкодеров)

// === 5. Направление движения (дифференциальное управление) ===
// Эти нити позволяют управлять каждым мотором/приводом отдельно
// Например: "left robot 50" → левый мотор получает скорость 50
left cord        // Левый мотор/привод (для дифференциального управления)
right cord       // Правый мотор/привод
up cord          // Верхний привод (например, для подъёмника или камеры)
down cord        // Нижний привод

// === 6. Окружающая среда и датчики ===
temperature cord // Температура (показания датчика или уставка климата)
threshold cord   // Порог срабатывания (для ИК-датчиков, звука, компараторов)

// === 7. Логика и режимы ===
mode cord        // Режим работы (число или строка: "авто", "ручной", "сон")
timeout cord     // Таймаут (время ожидания или длительность действия в мс)

main // Возвращаемся в основной контекст