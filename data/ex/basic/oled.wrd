// load ex/basic/oled.wrd <-- xxx
OLED focus
sda = 25
scl = 24
pole.buf = array u8 129 // Для сканирования и отправки страницы


i2c.Init sda scl
->

cmd.buf = array u8 26
cmd.buf [ ] = 0x00 0xAE 0xD5 0x80 0xA8 0x3F 0xD3 0x00 0x40 0x8D 0x14 0x20 0x00 0xA1 0xC8 0xDA 0x12 0x81 0xCF 0xD9 0xF1 0xDB 0x40 0xA4 0xA6 0xAF   

oled.adr = 0x3C
oled.test :
i2c.Scan pole.buf
json>

;


oled.init :
i2c.Write oled.adr cmd.buf
;

// start.buf = array u8 7
// start.buf [ ] = 0x00 0x21 0x00 0x7F 0x22 0x00 0x07
oled.zero :
// i2c.Write oled.adr start.buf
;



