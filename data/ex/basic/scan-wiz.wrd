// wiz.get "{"method":"setPilot","params":{"r":255,"g":255,"b":255,"dimming":100}}"
// wiz.get "{"method":"setPilot","params":{"temp":4000,"dimming":100}}"
// wiz.get "{"method":"setPilot","params":{"state":true}}"
main