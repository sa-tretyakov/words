// load test.wrd <-- xxx

/* 
  HTTP Client (HTTP-клиент) — отправка запросов и получение ответов от веб-серверов.
  
  Образ диалога с устройством
  Этот файл является образом диалога, который обучает систему словам и поведению
  для работы с HTTP-протоколом. Робот умеет подключаться к веб-серверам,
  отправлять GET-запросы и читать ответы (JSON, HTML, статусы).
  
  Обучить модуль можно введя этот диалог: load ex/http/http_client.words <--
*/

// 1. Загрузка констант HTTP-протокола
// Эти константы используются для формирования правильных HTTP-запросов

webconst load? ex/http/webconst.wrd

http focus // Переходим в контекст "http" для работы с веб-протоколом

// 2. Настройка подключения
// Адрес и порт сервера, с которым будем общаться
tcp.adres = "192.168.0.100"  // IP-адрес сервера (можно изменить)
tcp.port = 80                // Стандартный порт HTTP

// 3. Подготовка буфера для приёма данных
// Выделяем память под ответ сервера (максимум 2048 байт)
buf = array u8 2048

// 4. Служебные переменные
task.to.kill = 0u16  // Сюда будем запоминать ID фоновой задачи
tcp.line = 255       // Номер сокета (255 = не открыт)

// 5. Чтение статуса ответа
// Слово getStatus анализирует полученный ответ от сервера
// и выводит его в понятном человеку виде
getStatus : // n (количество прочитанных байт)
n = 
    // Печатаем заголовок
    print "Статус: "
    
    // Находим первую строку ответа (до CRLF)
    line1.end = find buf CRLF -) 0
    part$ buf 0 line1.end     // Извлекаем строку статуса
    ->                        // Удаляем со стека (мы её уже вывели)
    println                   // Печатаем с новой строки
    
    // Печатаем заголовки ответа
    println "Заголовки:"
    line2.end = find buf CRLF2 -) 0  // Ищем конец заголовков
    part$ buf line1.end + 2 line2.end // Извлекаем заголовки
    ->                               // Удаляем со стека
    println                           // Печатаем с новой строки
    
    // Выводим тело ответа (первые 255 байт)
    part$ buf line2.end + 4 n  // Извлекаем тело
    if ! {                     // Если тела нет
        println
        exit                    // Выходим
    }
    print                      // Печатаем тело
    
    // Если ответ длиннее 255 байт, показываем остаток
    part$ buf line2.end + 259 n
    if ! {                     // Если остатка нет
        println
        exit                    // Выходим
    }
    println                    // Печатаем остаток
;

// 6. Чтение данных из сокета
// Фоновая задача, которая ждёт ответ от сервера
http.read :
    if tcp.line == 255 {      // Если сокет не открыт
        exit                   // Выходим
    }
    
    if 0 != tcp.Available tcp.line {  // Если есть данные
        n = tcp.Recv tcp.line buf     // Читаем их в буфер
        tcp.Close tcp.line            // Закрываем сокет
        __remove_task__ task.to.kill  // Останавливаем фоновую задачу
        
        ln                            // Пустая строка
        getStatus n                   // Показываем статус ответа
    }
;

// 7. Отправка GET-запроса
// Главное слово, которое отправляет запрос к серверу
http.get : // adres port url (адрес, порт, путь)
    adress =  // Запоминаем адрес
    port =    // Запоминаем порт
    url =     // Запоминаем путь (например, "/modules.json")
    
    // Подключаемся к серверу
    tcp.line = tcp.Connect adress port
    
    // Перенаправляем вывод в сокет (пишем серверу)
    out>tcp tcp.line
    
    // Формируем HTTP-запрос (по правилам протокола)
    println  GET + url + " " + http.version  // GET /path HTTP/1.1
    println  Host: + adress               // Host: server
    println  h.connection                    // Connection: close
    println Empty.Line                       // Пустая строка — конец запроса
    
    // Возвращаем вывод в терминал (для отладки)
    out>serial
    
    // Планируем фоновую задачу для чтения ответа
    task.to.kill = http.read #  // Получаем адрес слова
    http.read 100 +task         // Запускаем задачу через 100 мс
;


// 8. Автозапуск при загрузке файла
// Пытаемся отправить запрос к серверу
// http.get tcp.adres tcp.port "/modules.json"
// http.get "77.88.55.60" 80 "/"

