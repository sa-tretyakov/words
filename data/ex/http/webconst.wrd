webconst focus
const http.version = "HTTP/1.1 "

http.ok :
 http.version + "200 OK" + CRLF
 ;
  
http.notFound :
http.version + "404 Not Found" + CRLF
;

http.notModified :
http.version + "304 Not Modified" + CRLF
;
 
http.redirect :
http.version + "301 Moved Permanently" + CRLF
; 
http.tempRedirect :
http.version + "302 Found" + CRLF
; 
http.badRequest :
http.version + "400 Bad Request" + CRLF
;
http.error.line :
http.version + "500 Internal Server Error" + CRLF
;
println :
print
ln
;

Empty.Line :
ln
;

