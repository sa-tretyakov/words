// load ex/net/udp_example.words
ssdp focus

// Создаём буфер на 1500 байт (стандартный максимум для UDP-пакета)
rx.buf = array u8 1500

soket.ssdp = udp.Multicast "239.255.255.250" 1900
print "soket.ssdp = "
print soket.ssdp
ln

ssdpRead :
    n = udp.Available soket.ssdp
    if n > 0 {
        // Вычёрпываем пакет из сокета в буфер, чтобы освободить сетевую очередь
        udp.Recv soket.ssdp rx.buf 
        // Разбираем стек (сверху вниз лежат: порт, IP, размер)
        print " SSDP-ответ от " 
        print 
        print ":" 
        print
        print " получено "
        print
        ln
        
    }
;

ssdpRead 50 +task
main