// load ex/net/web.wrd <-- xxx
load ex/http/webconst.wrd

web focus
mime = array $S 28
mime [ ] = htm @ t.html @ html @ t.html @ wrd @ t.html @ json @ t.json @ css @ t.css @ js @ t.js @ png @ t.png @ gif @ t.gif @ jpg @ t.jpg @ ico @ t.ico @ xml @ t.xml @ pdf @ t.pdf @ zip @ t.zip @ gz @ t.gz @


contType :
ext = "html"
ext = 
i = 0u8
// locals
while i < 28 {
if ext == mime [ i ] {
mime [ i + 1u8 ]
exit 
 }
i += 2u8
}
"application/octet-stream"
;

http.index = "/index.htm.gz" 
path? : // path
 path = 
    if "/" == path {        // если запрошен корень сайта
      http.index            // подменить путь на файл по умолчанию
      exit
    }
 path
;

?client :
  if 255 == {                          // если индекс 255 (никого нет в очереди на подключение)
    exit                                   // досрочно выйти из слова, ничего не делая
  }  
;

Response.Header : // index.htm.gz
println h.type + contType "htm"
println h.length + toStr fs.size
println h.encoding
println h.connection
;
Message.Body : // url
type
;
http.response : // cli index.htm.gz
   client =
   url = 
    Status.Line = http.ok
    print
    Response.Header
    Empty.Line
    Message.Body url
    // tcp.Close client 
;

notFound : // путь к файлу
client =
    if ! exists  {
    http.response client                        // Отправить 404
    exit 
    }
;



