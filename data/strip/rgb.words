// load strip/rgb.words <--
strip
// strip.destination  = nullArray 
// strip.source  = nullArray 
strip.length = 3 // Максимальная длина ленты (в пикселях)
const GRB = 3u8
const WRGB = 4u8
strip.chanals = 0u8
strip.pins = 19u8
device flame
// 4. Создание буферов памяти для пикселей
strip.flameBufer = array u8 strip.length * WRGB // массив в байтах для ленты flame
strip.flameBufer view view.flame u32 // представление массива в u32
strip.flame = array u32 strip.length // массив хранения состояния ленты flame

copy>flameBufer :
copy view.flame 0 len view.flame strip.flame
;

on.flame :
if flame == {
copy>flameBufer
}
;
on on.flame bead

off.flame :
if flame == {
rgb2wrgb view.flame 0 len view.flame 0x000000
}
;
off off.flame bead

color.flame :
flame.color = 0u24
if flame == {
flame.color = 
rgb2wrgb strip.flame 0 len strip.flame flame.color
copy>flameBufer
}
;
color color.flame bead

strip.Init strip.chanals strip.pins view.flame

device light
strip.length = 128u8 
strip.chanals += 1u8
strip.pins = 23u8
strip.lightBufer = array u8 strip.length * GRB // массив в байтах для ленты light
strip.lightBufer view view.light u24 // представление массива в u32 light
strip.light = array u24 strip.length // массив хранения состояния ленты light

copy>lightBufer :
copy view.light 0 len view.light strip.light
;

on.light :
if light == {
copy>lightBufer
}
;
on on.light bead

off.light :
if light == {
rgb2grb view.light 0 len view.light 0x000000
}
;
off off.light bead

color.light :
light.color = 0u24
if light == {
light.color = 
rgb2grb strip.light 0 len strip.light light.color
copy>lightBufer
}
;
color color.light bead

strip.Init strip.chanals strip.pins view.light

device fuelbed
strip.length = 128u8 
strip.chanals += 1u8
strip.pins = 5u8
// strip.test = array u8 strip.length * GRB // массив в байтах для ленты fuelbed
// strip.fuelbedBufer view view.fuelbed u24    // представление массива в u32 fuelbed
// strip.fuelbed = array u24 strip.length     // массив хранения состояния ленты fuelbed


rmt.AllBegin 10 +task


// color flame 0xFFFFFF
// color light 0x0000FF

~ :
off flame
off light
rmt.AllBegin
reset
;
main